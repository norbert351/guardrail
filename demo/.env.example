# GuardRail demo — Claude (AgentRouter gateway) config.
# Copy to .env and fill in. demo/.env is gitignored — never commit the token.
#
# Verified gateway facts (do not re-derive):
#   - base URL has NO /v1; endpoint is {base}/v1/messages
#   - auth: Authorization: Bearer <token> (this is ANTHROPIC_AUTH_TOKEN, not x-api-key)
#   - working model: claude-opus-4-8. 4-6/4-7 have no channel (503 无可用渠道).
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://agentrouter.org
ANTHROPIC_MODEL=claude-opus-4-8
